# Copy to .env.vision on the host only. Do not put secrets in browser JS.
# Full OpenAI-compatible chat/completions endpoint. HTTPS required except localhost.
SWAP_VISION_CHAT_URL=
SWAP_VISION_MODEL=
SWAP_VISION_API_KEY=
# Optional for providers supporting enable_thinking (e.g. Qwen): false / true.
# Leave empty for other compatible providers.
SWAP_VISION_THINKING=
# Example endpoint shape: https://your-provider.example/v1/chat/completions
# Restart the page service after editing. Empty values keep API mode unavailable.
