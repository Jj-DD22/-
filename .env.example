# Copy to .env. Use the IP address of the generation host for LAN clients.
SWAP_SHARED=1
SWAP_STUDIO_PORT=8780
SWAP_ALLOWED_ADDRESSES=127.0.0.1
SWAP_COMFY_URL=http://127.0.0.1:8188

# Replace with the Python executable that has Pillow, NumPy and SciPy installed.
# Windows example below; Linux may use /opt/comfyui/.venv/bin/python.
SWAP_PYTHON=C:/AI/ComfyUI_windows_portable/python_embeded/python.exe

# Relative paths resolve from this source folder.
SWAP_SHARED_DATA=./data
SWAP_JOB_DIR=./data/jobs
PYTHONUTF8=1
